# RO WHOLESALE B2B AUTHENTICATION SERVER ENVIRONMENT CONFIGURATION

PORT=8081
SESSION_SECRET=RO_WHOLESALE_SECRET_KEY_2026
# Use a separate random secret (32+ bytes) for employee tokens in production.
SHOP_EMPLOYEE_SESSION_SECRET=
# Optional: explicitly route new customer orders to this active shop name.
# When blank, checkout auto-assigns only if exactly one active shop is registered;
# with multiple shops, assign orders from the Admin Panel.
SHOP_DEFAULT_NAME=

# Supabase Auth token verification bridge (server-side URL + publishable/anon key).
# Never put SUPABASE_SERVICE_ROLE_KEY or PostgreSQL credentials in Flutter/Web.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Flutter build define: SUPABASE_PUBLISHABLE_KEY (or legacy SUPABASE_ANON_KEY).
# Flutter build define: USE_SUPABASE_CHECKOUT (opt-in; defaults to false).

# SUPABASE POSTGRESQL DATABASE CONFIGURATION (backend only)
# Use the server-side PostgreSQL URI from Supabase Database settings.
# URL-encode reserved characters in the password. Never put this value in Flutter/web code.
SUPABASE_DB_URL=postgresql://postgres:<PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require
# Optional: path to the project's downloaded Supabase root CA certificate (PEM).
# TLS and certificate/hostname verification remain mandatory in db.js.
SUPABASE_DB_SSL_CA_FILE=

# Supabase Edge Function secrets (configure in Supabase project settings only;
# never put service-role/payment secrets in Flutter or web build defines).
# SUPABASE_SERVICE_ROLE_KEY=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# SHOP_DEFAULT_NAME=
DB_CONNECTION_LIMIT=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000

# Server-side Razorpay merchant credentials; never place the secret in Flutter.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# REAL EMAIL / SMTP CONFIGURATION OPTIONS
# Option A: Gmail SMTP (Recommended)
# 1. Enable 2-Step Verification on your Google Account (myaccount.google.com)
# 2. Generate an App Password at: https://myaccount.google.com/apppasswords
# 3. Enter your Gmail and 16-character App Password below:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="RO Wholesale Security" <no-reply@ro-wholesale.com>

# Option B: SendGrid / Resend / Brevo / Custom SMTP
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=your_sendgrid_api_key

# Option C: HTTPS Email Webhook / REST API
# EMAIL_API_WEBHOOK_URL=https://your-email-webhook.com/send

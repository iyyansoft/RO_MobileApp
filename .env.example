# Render supplies PORT automatically. Local development can set it explicitly.
PORT=
NODE_ENV=production

# Required backend session and admin credentials. Generate unique private values in Render.
# Production requires 32+ characters for both session secrets and 16+ for the admin password.
SESSION_SECRET=
SHOP_EMPLOYEE_SESSION_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Existing Supabase project (public API settings; not the service-role key).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Legacy alias accepted by the backend during transition.
SUPABASE_ANON_KEY=

# Existing Supabase PostgreSQL direct/session-pooler connection (server only).
SUPABASE_DB_URL=postgresql://<USERNAME>:<PASSWORD>@<SUPABASE_SESSION_POOLER_HOST>:5432/postgres?sslmode=verify-full
# Optional CA input: paste the public PEM certificate here, or use a relative file path.
SUPABASE_DB_SSL_CA=
SUPABASE_DB_SSL_CA_FILE=certs/supabase-root.crt
DB_CONNECTION_LIMIT=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000

# Browser admin dashboard origins, comma-separated. Include the deployed web URL.
CORS_ORIGINS=

# Optional integrations. Configure only if the corresponding feature is enabled.
GOOGLE_CLIENT_ID=
# Preferred transactional email provider for Render Free (HTTPS; no SMTP egress needed).
# Verify this sender/domain in Brevo before configuring these values in Render.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
EMAIL_REQUEST_TIMEOUT_MS=10000
# Optional fallback for environments where outbound TLS SMTP is available.
# Use port 465 with SMTP_SECURE=true, or port 587 with SMTP_SECURE=false (STARTTLS required).
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_CONNECTION_TIMEOUT_MS=
SMTP_GREETING_TIMEOUT_MS=
SMTP_SOCKET_TIMEOUT_MS=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
SHOP_DEFAULT_NAME=
